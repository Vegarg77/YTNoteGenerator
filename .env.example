# LLM API (OpenRouter by default, or any OpenAI-compatible provider)
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731
# Base URL of the API. Default is OpenRouter; set to a compatible provider to switch.
#   OpenRouter: https://openrouter.ai/api  (default — may omit)
#     deepseek/deepseek-v4-flash-0731 is pinned to the July 2026 retrain — OpenRouter's
#     bare "deepseek/deepseek-v4-flash" alias resolves to an older (April 2026) snapshot.
#     The request body is routed with a price ceiling ($0.22/M prompt, $0.66/M completion)
#     sorted by throughput among the providers under that ceiling (see the
#     OPENROUTER_PROVIDER_ROUTING injection in webapp/app.js) — same policy as this
#     project's Hermes agent config and CI code-review workflow.
#   DeepSeek direct: https://api.deepseek.com  (then set OPENAI_MODEL=deepseek-v4-flash;
#     deepseek-chat is NOT a valid model name on some DeepSeek accounts)
#   OpenAI:   https://api.openai.com   (then set OPENAI_MODEL=gpt-4o-mini or similar)
OPENAI_BASE_URL=https://openrouter.ai/api

# Bright Data Dataset API (required for YouTube transcripts and Wikipedia lookups)
BRIGHT_DATA_API_TOKEN=your-bright-data-api-token
BRIGHT_DATA_YT_DATASET_ID=gd_lk56epmy2i5g7lzu0k
BRIGHT_DATA_WIKI_DATASET_ID=gd_lr9978962kkjr3nx49

# Optional overrides
# BRIGHT_DATA_API_BASE=https://api.brightdata.com
# BRIGHT_DATA_TIMEOUT_MS=120000
# BRIGHT_DATA_POLL_INTERVAL_MS=2000

# Note paths (where Obsidian notes are saved)
# OBSIDIAN_NOTE_DIR=/path/to/video-notes
# OBSIDIAN_DICTIONARY_DIR=/path/to/dictionary-notes
# OBSIDIAN_BUSINESS_DIR=/path/to/business-notes

# Optional app settings
# PORT=5173

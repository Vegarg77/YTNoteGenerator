# LLM API (OpenAI or any OpenAI-compatible provider, e.g. DeepSeek)
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini
# Base URL of the API. Default is OpenAI; set to a compatible provider to switch.
#   OpenAI:   https://api.openai.com   (default — may omit)
#   DeepSeek: https://api.deepseek.com  (then set OPENAI_MODEL=deepseek-chat)
#     Use deepseek-chat (non-reasoning) — faster + cheaper than the v4-flash/pro
#     reasoning models, which waste tokens "thinking" on this simple task.
OPENAI_BASE_URL=https://api.openai.com

# Bright Data Dataset API (required for YouTube transcripts and Wikipedia lookups)
BRIGHT_DATA_API_TOKEN=your-bright-data-api-token
BRIGHT_DATA_YT_DATASET_ID=gd_lk56epmy2i5g7lzu0k
BRIGHT_DATA_WIKI_DATASET_ID=gd_lr9978962kkjr3nx49

# Optional overrides
# BRIGHT_DATA_API_BASE=https://api.brightdata.com
# BRIGHT_DATA_TIMEOUT_MS=120000
# BRIGHT_DATA_POLL_INTERVAL_MS=2000

# Note paths (where Obsidian notes are saved)
# OBSIDIAN_NOTE_DIR=/path/to/video-notes
# OBSIDIAN_DICTIONARY_DIR=/path/to/dictionary-notes
# OBSIDIAN_BUSINESS_DIR=/path/to/business-notes

# Optional app settings
# PORT=5173
